{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uwcourses",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 2000
  },
  "placement": {
    "mode": "smart"
  },
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uwcourses",
      "database_id": "acb149f1-0a7e-454e-bb38-69f0de086ba2"
    }
  ],
  "vars": {
    "D1_READ_MODE": "primary",
    "D1_QUERY_LOGS": "0"
  }
}
